{
	"name": "df_repartidores",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "repartidores_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "repartidores_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(repartidor_id = upper(trim(repartidor_id)),",
				"          nombre_repartidor = initCap(lower(trim(nombre_repartidor))),",
				"          tipo_vehiculo = initCap(lower(trim(tipo_vehiculo))),",
				"          ciudad_base = initCap(lower(trim(ciudad_base))),",
				"          fecha_alta = toDate(trim(fecha_alta), 'yyyy-MM-dd'),",
				"          activo = iif(\r",
				"    in(['1', 'true', 'sí', 'si', 's'], lower(trim(toString(activo)))), \r",
				"    'Sí', \r",
				"    'No'\r",
				")) ~> derivedColumn1",
				"derivedColumn1 derive(activo = toString(activo)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as date,",
				"          activo as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          repartidor_id,",
				"          nombre_repartidor,",
				"          tipo_vehiculo,",
				"          ciudad_base,",
				"          fecha_alta,",
				"          activo",
				"     )) ~> sink1"
			]
		}
	}
}