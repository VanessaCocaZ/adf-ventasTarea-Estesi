{
	"name": "df_productos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "productos_menu_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "productos_menu_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          producto_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          precio_lista as string,",
				"          costo_estimado as string,",
				"          disponible as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(categoria = initCap(lower(trim(categoria))),",
				"          precio_lista_texto = replace(replace((trim(precio_lista)),'Bs ',''),',','.')) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(producto_id) && !isNull(precio_lista) && !isNull(costo_estimado),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos derive(precio_lista_texto = toDecimal(precio_lista),",
				"          costo_estimado = toDecimal(costo_estimado),",
				"          disponible = toString(disponible)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          producto_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          precio_lista as decimal(12,2),",
				"          costo_estimado as decimal(12,2),",
				"          disponible as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          producto_id,",
				"          nombre_producto,",
				"          categoria,",
				"          precio_lista = precio_lista_texto,",
				"          costo_estimado",
				"     )) ~> sink1"
			]
		}
	}
}