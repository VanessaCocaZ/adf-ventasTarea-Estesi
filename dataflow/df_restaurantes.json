{
	"name": "df_restaurantes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "restaurantes",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "restaurantes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          restaurante_id as string,",
				"          nombre_restaurante as string,",
				"          tipo_cocina as string,",
				"          calificacion_promedio as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(restaurante_id = upper(trim(restaurante_id)),",
				"          nombre_restaurante = initCap(lower(trim(nombre_restaurante))),",
				"          tipo_cocina = initCap(lower(trim(tipo_cocina))),",
				"          calificacion_promedio = toDecimal(trim(toString(calificacion_promedio)), 3, 2),",
				"          activo = iif(    in(['1', 'true', 'sí', 'si', 's'], lower(trim(toString(activo)))),     'Sí',     'No')) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(restaurante_id) && !isNull(nombre_restaurante) && !isNull(tipo_cocina),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos derive(activo = toString(activo)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          restaurante_id as string,",
				"          nombre_restaurante as string,",
				"          tipo_cocina as string,",
				"          calificacion_promedio as decimal(3,2),",
				"          activo as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          restaurante_id,",
				"          nombre_restaurante,",
				"          tipo_cocina,",
				"          calificacion_promedio",
				"     )) ~> sink1"
			]
		}
	}
}