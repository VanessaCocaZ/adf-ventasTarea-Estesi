{
	"name": "df_entrega",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "entregas_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "entregas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          entrega_id as string,",
				"          pedido_id as string,",
				"          repartidor_id as string,",
				"          hora_salida as string,",
				"          hora_entrega as string,",
				"          tiempo_entrega_min as string,",
				"          distancia_km as string,",
				"          estado_entrega as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(entrega_id = upper(trim(entrega_id)),",
				"          pedido_id = upper(trim(pedido_id)),",
				"          repartidor_id = upper(trim(repartidor_id)),",
				"          hora_salida = toTimestamp(trim(hora_salida), 'yyyy-MM-dd HH:mm:ss'),",
				"          hora_entrega = iif(isNull(hora_entrega) || trim(hora_entrega) == '', toTimestamp(null()), toTimestamp(trim(hora_entrega), 'yyyy-MM-dd HH:mm:ss')),",
				"          estado_entrega = initCap(lower(trim(estado_entrega))),",
				"          tiempo_entrega_min = iif(toDecimal(trim(toString(tiempo_entrega_min))) > 0, toDecimal(trim(toString(tiempo_entrega_min))), toDecimal(null())),",
				"          distancia_km = toDecimal(trim(toString(distancia_km)), 6, 2)) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(entrega_id) &&!isNull(pedido_id)&&!isNull(repartidor_id)&&!isNull(estado_entrega)&&!isNull(hora_entrega)&&!isNull(tiempo_entrega_min),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          entrega_id as string,",
				"          pedido_id as string,",
				"          repartidor_id as string,",
				"          hora_salida as timestamp,",
				"          hora_entrega as timestamp,",
				"          tiempo_entrega_min as integer,",
				"          distancia_km as decimal(6,2),",
				"          estado_entrega as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          entrega_id,",
				"          pedido_id,",
				"          repartidor_id,",
				"          hora_salida,",
				"          hora_entrega,",
				"          tiempo_entrega_min,",
				"          distancia_km,",
				"          estado_entrega",
				"     )) ~> sink1"
			]
		}
	}
}